// Workspace for in-repo development: every module builds against the
// checked-out tree instead of published versions. `go install
// <module>@version` ignores this file, so released installs are
// unaffected.
go 1.27.1

use (
	.
	./cmd/nexus
	./di/fxcontainer
	./extension/cache/redis
	./extension/jobs/jobsamqp
	./extension/jobs/jobsredis
	./httpx/ginrouter
	./view/example
)

// v2 is unreleased: required v2.0.0 versions resolve to the checkouts.
replace (
	github.com/paulmanoni/nexus/v2 v2.0.0 => ./

	// Unreleased deco: ScanWith prefixes for //nexus: directives. Drop once
	// a deco release with ScanOptions is tagged and required by cmd/nexus.
	github.com/paulmanoni/deco => /Users/amtz/Documents/personal/deco
)
