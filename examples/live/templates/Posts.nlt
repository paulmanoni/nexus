<template>
    <div class="posts">
        <h1>Posts ({{ len(Posts) }})</h1>

        <input nl-model="Filter"
               @keydown.escape="clearFilter"
               placeholder="Filter by title… (Esc to clear)"/>

        <ul>
            <PostRow nl-for="p in Posts" :key="p.ID" :post="p"/>
        </ul>

        <p nl-if="len(Posts) == 0">No posts match "{{ Filter }}".</p>

        <form @submit.prevent="add">
            <input nl-model="NewTitle" placeholder="New post title… (Enter to add)"/>
            <button type="submit">Add</button>
        </form>

        <h2>Counter (vanilla-JS island)</h2>
        <nl-island name="Counter"
                   src="/islands/counter.js"
                   :props="CounterProps()"/>
        <form @submit.prevent="resetCounter">
            <button type="submit">Server reset (PushIsland)</button>
        </form>

        <h2>Activity</h2>
        <p class="hint">
            This list is updated via <code>ctx.Stream("activity").Append(...)</code> —
            individual <code>stream-op</code> frames, no re-render of the surrounding
            template.
        </p>
        <ul nl-stream="activity" class="activity"></ul>

        <p class="hint">
            Open this URL in another tab — like, add, or filter in one and the
            others stay in sync via the Notifier + sparse diffs.
        </p>

        <p>
            <a nl-navigate href="/about">About this demo</a>
        </p>
    </div>
</template>

