<template>
    <div class="crons">
        <h1>Cron jobs ({{ len(Crons) }})</h1>
        <p class="hint">
            Live view of <code>cron.Scheduler.Snapshots()</code>.
            The scheduler's <code>OnChange</code> hook is wired into
            <code>nexus.Notifier</code> at app boot, so this page
            re-renders the moment any job ticks — no polling, no
            JavaScript framework, the same dashboard tab the Vue
            UI exposes but with ~30 lines of template.
        </p>

        <input nl-model="Filter"
               @keydown.escape="clearFilter"
               placeholder="Filter by name… (Esc to clear)"/>

        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Schedule</th>
                    <th>Status</th>
                    <th>Next run</th>
                    <th>Last run</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr nl-for="c in Crons" :key="c.Name">
                    <td>
                        <strong>{{ c.Name }}</strong>
                        <small nl-if="c.Description">{{ c.Description }}</small>
                    </td>
                    <td><code>{{ c.Schedule }}</code></td>
                    <td>
                        <span :class="Status(c)">{{ Status(c) }}</span>
                    </td>
                    <td>{{ Until(c.NextRun) }}</td>
                    <td>
                        <span :class="LastResult(c.LastRun)">
                            {{ Ago(c.LastRun) }}
                        </span>
                    </td>
                    <td class="actions">
                        <button @click="trigger(c.Name)">Trigger</button>
                        <button nl-if="c.Paused" @click="resume(c.Name)">Resume</button>
                        <button nl-else @click="pause(c.Name)">Pause</button>
                    </td>
                </tr>
            </tbody>
        </table>

        <p nl-if="len(Crons) == 0" class="empty">
            No crons match "{{ Filter }}".
        </p>
    </div>
</template>

<style scoped>
    .crons {
        font-family: system-ui, sans-serif;
        max-width: 56rem;
        margin: 2rem auto;
        padding: 0 1rem;
    }

    .crons h1 {
        font-size: 1.5rem;
        margin-bottom: 0.25rem;
    }

    .crons .hint {
        color: #666;
        font-size: 0.9rem;
        line-height: 1.5;
        margin-bottom: 1.5rem;
    }

    .crons code {
        background: #f4f4f4;
        padding: 0 0.25rem;
        border-radius: 3px;
        font-family: ui-monospace, monospace;
        font-size: 0.85em;
    }

    .crons input {
        width: 100%;
        padding: 0.5rem 0.75rem;
        border: 1px solid #ddd;
        border-radius: 4px;
        box-sizing: border-box;
        margin-bottom: 1rem;
        font-size: 0.95rem;
    }

    .crons table {
        width: 100%;
        border-collapse: collapse;
    }

    .crons th,
    .crons td {
        padding: 0.65rem 0.75rem;
        border-bottom: 1px solid #eee;
        text-align: left;
        vertical-align: top;
    }

    .crons th {
        font-size: 0.8rem;
        text-transform: uppercase;
        color: #888;
        font-weight: 600;
        letter-spacing: 0.04em;
    }

    .crons td strong {
        display: block;
        font-weight: 600;
    }

    .crons td small {
        color: #888;
        font-size: 0.8rem;
    }

    .crons span.running,
    .crons span.paused,
    .crons span.idle {
        display: inline-block;
        padding: 0.1rem 0.55rem;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 500;
    }
    .crons span.running { background: #e6f4ea; color: #1e7e34; }
    .crons span.paused  { background: #fff3cd; color: #856404; }
    .crons span.idle    { background: #eee;    color: #555;    }

    .crons span.ok   { color: #1e7e34; }
    .crons span.fail { color: #c0392b; font-weight: 500; }

    .crons .actions {
        white-space: nowrap;
    }

    .crons .actions button {
        font-size: 0.85rem;
        padding: 0.25rem 0.6rem;
        margin-right: 0.25rem;
        background: #fff;
        border: 1px solid #ccc;
        border-radius: 4px;
        cursor: pointer;
    }

    .crons .actions button:hover {
        background: #f6f6f6;
    }

    .crons .empty {
        color: #888;
        font-size: 0.9rem;
        margin-top: 1.5rem;
    }
</style>
