{
  "//": "TS config for the islands' source. Vite handles the actual transform; this file is for editor IntelliSense + tsc --noEmit type-checking. The Go code lives outside, doesn't need TS coverage.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": [
    "islands.src/**/*.ts",
    "islands.src/**/*.vue",
    "vite.config.ts"
  ]
}
