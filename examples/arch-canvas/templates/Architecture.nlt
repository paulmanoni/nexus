        font-size: 0.85rem;
    }

    /* The island root inherits these styles — sized + chromed
       by the host page rather than by the SFC, so the built
       bundle has no companion .css to ship. */
    .arch [nl-island="ArchCanvas"] {
        display: block;
        height: 460px;
        border: 1px solid #e1e4e8;
        border-radius: 6px;
        background: #fafbfc;
        overflow: hidden;
