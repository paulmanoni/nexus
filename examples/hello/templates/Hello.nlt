<template>
    <div class="page">
        <h1>Hello, world!</h1>
        <p>Server count: <strong>{{ Count }}</strong></p>
        <button @click="bump">Bump server</button>

        <h2>Client island</h2>
        <p class="hint">
            Vanilla JS island below — its own state, mounted once,
            untouched by server re-renders. The "Server ping" button
            fires <code>ctx.PushIsland("Counter", "ping", nil)</code>,
            which the island's <code>channel.on("ping")</code> picks
            up without touching the surrounding template.
        </p>
        <button @click="pingIsland">Server ping</button>

        <nl-island name="Counter"
                   src="/islands/counter.js"
                   :props="ClientProps()"/>
    </div>
</template>

