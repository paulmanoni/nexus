    <div class="max-w-xl mx-auto my-8 px-4 font-sans">
        <h1 class="text-2xl font-semibold mb-2">Hello, world!</h1>
        <p class="text-gray-700 mb-4">
            Server count:
            <strong class="font-mono text-blue-600">{{ Count }}</strong>
        </p>
        <button @click="bump"
                class="px-4 py-1.5 mr-2 rounded-md bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 transition-colors">
            Bump server
        </button>

        <h2 class="text-lg font-semibold mt-8 mb-2">Client island</h2>
        <p class="text-sm text-gray-600 mb-3 leading-relaxed">
            Vanilla JS island below — its own state, mounted once,
            untouched by server re-renders. The "Server ping" button
            fires <code class="bg-gray-100 px-1.5 py-0.5 rounded text-xs font-mono">ctx.PushIsland("Counter", "ping", nil)</code>,
            which the island's <code class="bg-gray-100 px-1.5 py-0.5 rounded text-xs font-mono">channel.on("ping")</code> picks
            up without touching the surrounding template.
        </p>
        <button @click="pingIsland"
                class="px-4 py-1.5 mb-3 rounded-md bg-gray-200 text-gray-800 text-sm font-medium hover:bg-gray-300 transition-colors">
            Server ping
        </button>

        <div class="mt-2 p-3 border border-gray-200 rounded-md bg-gray-50">
