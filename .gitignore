# Binaries
*.exe
*.test
*.out
/dist/
.DS_Store

# Build output dir (Makefile builds the CLI to bin/nexus for the drift gate).
/bin/

# Compiled CLI binary at repo root (produced by `go build`/`go install`).
# Leading slash anchors it to the root so it never matches the cmd/nexus/
# package dir or import paths.
/nexus

# Other committed compiled binaries (Mach-O / ELF outputs of go build).
# Anchored so only these exact paths are ignored, not source dirs.
/arch-canvas
/examples/wsecho/wsecho
