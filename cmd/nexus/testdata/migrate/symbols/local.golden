package main

import (
	"github.com/paulmanoni/nexus/v2"
	nexusconfig "github.com/paulmanoni/nexus/v2/config"
)

// A local named config takes the package name, so the import is aliased.
func main() {
	config := nexusconfig.Runtime{Introspection: true}
	config.Server.Addr = nexusconfig.Get[string]("addr", ":8080")
	nexus.Run(config)
}

func dotenv() {
	// TODO(nexus v2): nexus.MustLoadDotenv() is gone; nexus.toml loads .env itself — list a required file as [runtime] dotenv = ["!.env"]
	opt := nexus.MustLoadDotenv()
	_ = opt
}
