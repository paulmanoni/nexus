package input

import "github.com/paulmanoni/nexus/extension/dashboard/internal/ui/utils"

type Type string

const (
	TypeText   Type = "text"
	TypeNumber Type = "number"
	TypeSearch Type = "search"
)

type Props struct {
	ID          string
	Class       string
	Attributes  templ.Attributes
	Name        string
	Type        Type
	Placeholder string
	Value       string
	Disabled    bool
	Required    bool
}

templ Input(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Type == "" {
		{{ p.Type = TypeText }}
	}
	<input
		if p.ID != "" {
			id={ p.ID }
		}
		type={ string(p.Type) }
		if p.Name != "" {
			name={ p.Name }
		}
		if p.Placeholder != "" {
			placeholder={ p.Placeholder }
		}
		if p.Value != "" {
			value={ p.Value }
		}
		disabled?={ p.Disabled }
		required?={ p.Required }
		class={
			utils.TwMerge(
				"flex h-7 w-full min-w-0 rounded-sm border border-input bg-card px-2 text-[12.5px] outline-none transition-[color,box-shadow]",
				"placeholder:text-muted-foreground",
				"focus-visible:border-primary focus-visible:ring-2 focus-visible:ring-ring/40",
				"disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50",
				p.Class,
			),
		}
		{ p.Attributes... }
	/>
}
