package dashboard

import (
	"strings"

	"github.com/paulmanoni/nexus/extension/dashboard/internal/ui/badge"
	"github.com/paulmanoni/nexus/extension/dashboard/internal/ui/button"
	"github.com/paulmanoni/nexus/extension/dashboard/internal/ui/icon"
	"github.com/paulmanoni/nexus/extension/dashboard/internal/ui/input"
	"github.com/paulmanoni/nexus/extension/dashboard/internal/ui/table"
	"github.com/paulmanoni/nexus/trace"
)

// ---- Traces ----
templ tracesPage(q listQuery, rows []requestRow, p pager) {
	<div data-events="request.end">
		@pageHead("Traces", p.Total) {
			<div class="flex rounded-sm border border-border-strong bg-card p-px text-[12px]">
				@segLink("All", q.href("errors", ""), q.Args["errors"] == "")
				@segLink("Errors", q.href("errors", "1"), q.Args["errors"] != "")
			</div>
			@searchBox(q, "Search path, endpoint, status…")
		}
		<div class="p-4">
			<div class="overflow-x-auto rounded-sm border bg-card">
				@table.Table(table.Props{ID: "traces"}) {
					@table.Header() {
						@table.Row() {
							@table.Head(table.HeadProps{Class: "w-[90px]"}) {
								Time
							}
							@table.Head(table.HeadProps{Class: "w-[76px]"}) {
								Status
							}
							@table.Head() {
								Request
							}
							@table.Head() {
								Endpoint
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								Duration
							}
						}
					}
					@table.Body() {
						for _, r := range rows {
							@table.Row(table.RowProps{Class: "cursor-pointer", Attributes: templ.Attributes{
								"data-href":   Prefix + "/ui/traces/" + r.TraceID,
								"data-search": searchText(r.Method, r.Path, r.Endpoint, r.Service, r.Transport, itoa(r.Status), r.Error),
							}}) {
								@table.Cell(table.CellProps{Class: "font-mono text-[11.5px] text-muted-foreground whitespace-nowrap"}) {
									<span title={ stamp(r.At) }>{ clock(r.At) }</span>
								}
								@table.Cell() {
									@statusBadge(r)
								}
								@table.Cell(table.CellProps{Class: "max-w-0 w-[45%]"}) {
									<div class="truncate font-mono text-[12px]">
										if r.Method != "" {
											<b class="font-semibold">{ r.Method }</b>
										}
										{ r.Path }
									</div>
									if r.Error != "" {
										<div class="truncate font-mono text-[11px] text-err" title={ r.Error }>{ r.Error }</div>
									}
								}
								@table.Cell(table.CellProps{Class: "max-w-0 text-muted-foreground"}) {
									<div class="truncate">
										{ r.Endpoint }
										if r.Service != "" {
											<span class="text-[11px]">· { r.Service }</span>
										}
									</div>
								}
								@table.Cell(table.CellProps{Class: "text-right tabular-nums whitespace-nowrap"}) {
									if r.Done {
										{ fmtMs(r.DurationMs) }
									} else {
										<span class="text-muted-foreground">…</span>
									}
								}
							}
						}
						if len(rows) == 0 {
							@emptyRow(5, emptyMessage(q, "No requests in the trace buffer yet."))
						}
					}
				}
			</div>
			@pagerBar(q, p)
		</div>
	</div>
}

templ statusBadge(r requestRow) {
	switch  {
		case !r.Done:
			@badge.Badge(badge.Props{Variant: badge.VariantInfo}) {
				live
			}
		case r.failed():
			@badge.Badge(badge.Props{Variant: badge.VariantErr}) {
				if r.Status != 0 {
					{ itoa(r.Status) }
				} else {
					error
				}
			}
		case r.Status >= 400:
			@badge.Badge(badge.Props{Variant: badge.VariantWarn}) {
				{ itoa(r.Status) }
			}
		default:
			@badge.Badge(badge.Props{Variant: badge.VariantOK}) {
				if r.Status != 0 {
					{ itoa(r.Status) }
				} else {
					ok
				}
			}
	}
}

templ tracePage(id string, spans []*trace.SpanNode) {
	{{ total := traceExtent(spans) }}
	<div class="border-b bg-card px-4 py-2.5">
		@backLink(Prefix+"/ui/traces", "Traces")
		<div class="mt-1.5 flex flex-wrap items-center gap-2">
			<h1 class="text-[15px] font-semibold">Trace</h1>
			<code class="font-mono text-[12px] text-muted-foreground">{ id }</code>
			<span class="flex-1"></span>
			<span class="text-[12px] text-muted-foreground">{ plural(len(spans), "span", "spans") } · { fmtMs(total) }</span>
		</div>
	</div>
	<div class="p-4">
		<div class="overflow-x-auto rounded-sm border bg-card">
			<div class="grid grid-cols-[minmax(220px,38%)_1fr_72px] border-b bg-muted/60 px-3 py-1.5 text-[11px] font-semibold tracking-wide text-muted-foreground uppercase">
				<span>Span</span>
				<span>Timeline</span>
				<span class="text-right">Duration</span>
			</div>
			for _, s := range spans {
				<div class="grid grid-cols-[minmax(220px,38%)_1fr_72px] items-center gap-2 border-b px-3 py-1.5 text-[12.5px] last:border-0">
					<div class="min-w-0" style={ "padding-left: " + itoa(spanDepth(spans, s)*14) + "px" }>
						<div class="truncate font-medium">{ s.Name }</div>
						<div class="truncate text-[11px] text-muted-foreground">
							{ spanKind(s.Kind) }
							if s.Service != "" {
								· { s.Service }
							}
							if s.Status != 0 {
								· { itoa(s.Status) }
							}
						</div>
						if s.Error != "" {
							<div class="truncate font-mono text-[11px] text-err" title={ s.Error }>{ s.Error }</div>
						}
					</div>
					<div class="relative h-4 rounded-[1px] bg-sunken">
						<div
							class={ "absolute top-0.5 bottom-0.5 min-w-[2px] rounded-[1px]", templ.KV("bg-err", s.Error != ""), templ.KV("bg-primary", s.Error == "") }
							style={ "left: " + pct(s.StartMs, total) + "; width: " + pct(s.DurationMs, total) }
						></div>
					</div>
					<div class="text-right tabular-nums">{ fmtMs(s.DurationMs) }</div>
				</div>
				if len(s.Attrs) > 0 {
					<details class="border-b bg-sunken/40 px-3 py-1 last:border-0">
						<summary class="cursor-pointer text-[11.5px] text-muted-foreground">attributes</summary>
						<pre class="mt-1 overflow-auto font-mono text-[11px] leading-4">{ detailsJSON(s.Attrs) }</pre>
					</details>
				}
			}
		</div>
	</div>
}

// ---- Auth ----
templ authPage(st *consoleState, rejects []rejectRow, traced bool) {
	<div data-events="auth.reject">
		@pageHead("Auth", len(st.Auth.Identities)) {
			if st.Auth.CachingEnabled {
				@badge.Badge(badge.Props{Variant: badge.VariantOK}) {
					identity cache on
				}
			} else {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
					identity cache off
				}
			}
			@filterBox("#identities", "Filter identities…")
		}
		<div class="flex flex-col gap-4 p-4">
			@section("Invalidate") {
				<form data-json-form data-method="POST" data-action={ Prefix + "/auth/invalidate" } data-success="Invalidated" class="flex flex-wrap items-end gap-2 p-3">
					<label class="flex w-64 flex-col gap-1">
						@fieldLabel("Identity ID")
						@input.Input(input.Props{Name: "id", Placeholder: "user id — drops every cached token"})
					</label>
					<span class="pb-1.5 text-[12px] text-muted-foreground">or</span>
					<label class="flex w-72 flex-col gap-1">
						@fieldLabel("Token")
						@input.Input(input.Props{Name: "token", Placeholder: "a full bearer token"})
					</label>
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantDestructive}) {
						@icon.Icon("trash")
						Invalidate
					}
				</form>
			}
			@section("Cached identities") {
				@table.Table(table.Props{ID: "identities"}) {
					@table.Header() {
						@table.Row() {
							@table.Head() {
								Identity
							}
							@table.Head() {
								Roles
							}
							@table.Head() {
								Scopes
							}
							@table.Head() {
								Token
							}
							@table.Head() {
								Expires
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								Actions
							}
						}
					}
					@table.Body() {
						for _, id := range st.Auth.Identities {
							if id.Identity != nil {
								@table.Row(table.RowProps{Attributes: templ.Attributes{"data-search": searchText(id.Identity.ID, strings.Join(id.Identity.Roles, " "), strings.Join(id.Identity.Scopes, " "))}}) {
									@table.Cell(table.CellProps{Class: "font-medium"}) {
										{ id.Identity.ID }
									}
									@table.Cell() {
										@chips(id.Identity.Roles, badge.VariantInfo)
									}
									@table.Cell() {
										@chips(id.Identity.Scopes, badge.VariantOutline)
									}
									@table.Cell(table.CellProps{Class: "font-mono text-[12px] text-muted-foreground"}) {
										{ id.TokenPrefix }…
									}
									@table.Cell(table.CellProps{Class: "text-muted-foreground whitespace-nowrap"}) {
										@timeUntil(id.ExpiresAt)
									}
									@table.Cell(table.CellProps{Class: "text-right"}) {
										@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeSm, Attributes: templ.Attributes{
											"data-post":    Prefix + "/auth/invalidate",
											"data-body":    `{"id":` + jsonString(id.Identity.ID) + `}`,
											"data-success": "Invalidated " + id.Identity.ID,
										}}) {
											@icon.Icon("trash", "size-3")
											Drop
										}
									}
								}
							}
						}
						if len(st.Auth.Identities) == 0 {
							@emptyRow(6, "No identities cached.")
						}
					}
				}
			}
			@rejectsSection(rejects, traced)
		</div>
	</div>
}

// rejectsSection is every 401/403 auth handed out that the trace buffer
// still holds, newest first; the page re-renders as new ones arrive.
templ rejectsSection(rows []rejectRow, traced bool) {
	@section("Recent rejections") {
		if !traced {
			<p class="px-3 py-4 text-[12.5px] text-muted-foreground">Rejections are recorded in the trace buffer, which is off (trace_capacity = 0).</p>
		} else {
			@table.Table(table.Props{ID: "rejects"}) {
				@table.Header() {
					@table.Row() {
						@table.Head(table.HeadProps{Class: "w-[90px]"}) {
							Time
						}
						@table.Head(table.HeadProps{Class: "w-[70px]"}) {
							Status
						}
						@table.Head() {
							Reason
						}
						@table.Head() {
							Endpoint
						}
						@table.Head() {
							Identity
						}
						@table.Head() {
							Error
						}
					}
				}
				@table.Body() {
					for _, r := range rows {
						@table.Row(table.RowProps{Class: rejectClass(r), Attributes: rejectAttrs(r)}) {
							@table.Cell(table.CellProps{Class: "font-mono text-[11.5px] text-muted-foreground whitespace-nowrap"}) {
								<span title={ stamp(r.At) }>{ clock(r.At) }</span>
							}
							@table.Cell() {
								if r.Status == 401 {
									@badge.Badge(badge.Props{Variant: badge.VariantWarn}) {
										401
									}
								} else {
									@badge.Badge(badge.Props{Variant: badge.VariantErr}) {
										{ statusText(r.Status) }
									}
								}
							}
							@table.Cell(table.CellProps{Class: "font-mono text-[12px]"}) {
								{ r.Reason }
							}
							@table.Cell(table.CellProps{Class: "max-w-0 w-[28%]"}) {
								<div class="truncate">
									if r.Endpoint != "" {
										{ r.Endpoint }
										if r.Service != "" {
											<span class="text-[11px] text-muted-foreground">· { r.Service }</span>
										}
									} else {
										<span class="text-muted-foreground">—</span>
									}
								</div>
							}
							@table.Cell() {
								if r.Identity != "" {
									{ r.Identity }
								} else {
									<span class="text-muted-foreground">anonymous</span>
								}
							}
							@table.Cell(table.CellProps{Class: "max-w-0 w-[30%]"}) {
								<div class="truncate font-mono text-[11.5px] text-err" title={ r.Error }>{ r.Error }</div>
							}
						}
					}
					if len(rows) == 0 {
						@emptyRow(6, "No rejections yet. Every 401 and 403 from auth shows up here as it happens.")
					}
				}
			}
		}
	}
}

// ---- Runtime ----
templ runtimePage(st *consoleState) {
	@pageHead("Runtime", -1)
	<div class="grid gap-4 p-4 xl:grid-cols-2">
		@section("Global middleware") {
			if len(st.Global) == 0 {
				<p class="px-3 py-4 text-[12.5px] text-muted-foreground">No global middleware.</p>
			} else {
				<ol class="flex flex-wrap items-center gap-1.5 p-3">
					for i, m := range st.Global {
						if i > 0 {
							@icon.Icon("chevron-right", "size-3 text-muted-foreground")
						}
						<li>
							@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
								{ m }
							}
						</li>
					}
				</ol>
			}
		}
		@section("Plugins") {
			if len(st.Plugins) == 0 {
				<p class="px-3 py-4 text-[12.5px] text-muted-foreground">No plugins registered.</p>
			} else {
				<div class="flex flex-wrap gap-1.5 p-3">
					for _, p := range st.Plugins {
						<span class="inline-flex items-center gap-1.5 rounded-sm border bg-card px-2 py-0.5 text-[12px]">
							@icon.Icon("plug", "size-3 text-muted-foreground")
							<b class="font-medium">{ p.Name }</b>
							if p.Version != "" {
								<span class="text-muted-foreground">v{ p.Version }</span>
							}
						</span>
					}
				</div>
			}
		}
		@section("Middleware catalogue") {
			@table.Table() {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							Name
						}
						@table.Head() {
							Kind
						}
						@table.Head() {
							Description
						}
					}
				}
				@table.Body() {
					for _, m := range st.Middlewares {
						@table.Row() {
							@table.Cell(table.CellProps{Class: "font-mono text-[12px]"}) {
								{ m.Name }
							}
							@table.Cell() {
								@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
									{ string(m.Kind) }
								}
							}
							@table.Cell(table.CellProps{Class: "text-muted-foreground"}) {
								{ m.Description }
							}
						}
					}
					if len(st.Middlewares) == 0 {
						@emptyRow(3, "No middleware registered.")
					}
				}
			}
		}
		@section("GraphQL document cache") {
			@table.Table() {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							Mount
						}
						@table.Head(table.HeadProps{Class: "text-right"}) {
							Size
						}
						@table.Head(table.HeadProps{Class: "text-right"}) {
							Hits
						}
						@table.Head(table.HeadProps{Class: "text-right"}) {
							Misses
						}
						@table.Head(table.HeadProps{Class: "text-right"}) {
							Evictions
						}
					}
				}
				@table.Body() {
					for _, g := range st.GraphQL {
						@table.Row() {
							@table.Cell(table.CellProps{Class: "font-mono text-[12px]"}) {
								{ g.Path }
							}
							@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
								{ itoa(g.Size) } / { itoa(g.Capacity) }
							}
							@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
								{ u64(g.Hits) }
							}
							@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
								{ u64(g.Misses) }
							}
							@table.Cell(table.CellProps{Class: "text-right tabular-nums"}) {
								{ u64(g.Evictions) }
							}
						}
					}
					if len(st.GraphQL) == 0 {
						@emptyRow(5, "No GraphQL mounts.")
					}
				}
			}
		}
	</div>
}
