package pets

import (
	"strconv"

	"github.com/templui/templui/components/button"

	"github.com/paulmanoni/nexus/v2/view"
	"github.com/paulmanoni/nexus/view/example/v2/ui"
)

templ (b *Board) Render() {
	@ui.Layout("Adoption board") {
		<h1 class="text-2xl font-bold">Adoption board</h1>
		@ui.Section("Pets") {
			{{ note := view.State(ctx, "") }}
			<input id="note" class="w-full rounded-md border px-3 py-2" value={ note.Get() } oninput={ view.Do(func(e view.Event) { note.Set(e.Target.Value) }) } placeholder="A note — kept while the board updates"/>
			<p><b id="adopted">{ strconv.Itoa(len(b.Adopted)) }</b> adopted</p>
			@AdoptionMeter(MeterProps{Adopted: len(b.Adopted), Total: len(b.Pets)}) {
				<p class="text-sm text-muted-foreground">loading the meter…</p>
			}
			<ul class="space-y-2">
				for _, p := range b.Pets {
					<li id={ "pet-" + p.Name } class="flex items-center gap-2">
						<span class="w-24">{ p.Name }</span>
						if b.Adopted[p.Name] {
							<span class="text-muted-foreground">adopted</span>
							@button.Button(button.Props{ID: "return-" + p.Name, Variant: button.VariantOutline, Attributes: templ.Attributes{"onclick": view.Send(b.Return, p.Name)}}) {
								return
							}
						} else {
							@button.Button(button.Props{ID: "adopt-" + p.Name, Attributes: templ.Attributes{"onclick": view.Send(b.Adopt, p.Name)}}) {
								adopt
							}
						}
					</li>
				}
			</ul>
			<button id="clear" class="underline" onclick={ view.Send(b.Clear) }>clear all</button>
		}
		@ui.Section("Add a pet") {
			<form id="add" class="space-y-2" onsubmit={ view.Submit(b.Add) } oninput={ view.Change(b.Validate) }>
				<input id="add-name" name="name" class="w-full rounded-md border px-3 py-2" value={ b.Draft.Name } placeholder="Name"/>
				<p id="name-err" class="text-sm text-destructive">{ view.Errors(ctx).Field("name") }</p>
				<input id="add-kind" name="kind" class="w-full rounded-md border px-3 py-2" value={ b.Draft.Kind } placeholder="Kind"/>
				<p id="kind-err" class="text-sm text-destructive">{ view.Errors(ctx).Field("kind") }</p>
				@button.Button(button.Props{ID: "add-submit", Type: button.TypeSubmit}) {
					Add
				}
			</form>
		}
	}
}
