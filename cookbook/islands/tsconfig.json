{
  "//": "tsconfig covering Vue SFC + React TSX in one tree. Vite handles the actual transform; this file is for editor IntelliSense + vue-tsc / tsc --noEmit type checking.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": [
    "islands.src/**/*.ts",
    "islands.src/**/*.tsx",
    "islands.src/**/*.vue",
    "vue/**/*.vue",
    "vue/**/*.ts",
    "react/**/*.ts",
    "react/**/*.tsx",
    "vite.config.ts"
  ]
}
